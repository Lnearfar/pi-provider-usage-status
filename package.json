{
  "name": "pi-provider-usage-status",
  "version": "0.1.0",
  "description": "A Pi extension that shows Codex usage and DeepSeek or FaroAPI balance in the footer.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Jingyuan Li <nearfar1jy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lnearfar/pi-provider-usage-status.git"
  },
  "homepage": "https://github.com/Lnearfar/pi-provider-usage-status#readme",
  "bugs": {
    "url": "https://github.com/Lnearfar/pi-provider-usage-status/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "deepseek",
    "faroapi",
    "usage",
    "subscription"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "rm -rf .test-dist && tsc --noEmit false --outDir .test-dist && node .test-dist/test.js; status=$?; rm -rf .test-dist; exit $status"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
